(
var instance,rack,server,msgs=List.new,timers=List.new;
var checks=0,failures=List.new,check,reject,source,full,small,snapshot,oldBus,gen,one,oneRack,voiceNode,guiCommand;
">>>>> DEBUG START >>>>>".postln;
check={|condition,label|checks=checks+1;if(condition){("PASS "++label).postln}{failures.add(label);("FAIL "++label).postln}};
reject={|action,label|var caught=false;try{action.value}{|error|caught=true};check.value(caught,label)};
try {
    server=Server(\rackContract,NetAddr("127.0.0.1",59998),ServerOptions.new.numInputBusChannels_(0).numOutputBusChannels_(8));
    instance=AWBSendRackTool.open((width:1,channels:[\a,\b],fixedFX:[\mast,\verb],dynamicFX:1,fixedFollowers:[\env],spareFollowers:1),
        (server:server,sendFunction:{|msg|msgs.add(msg)},scheduleFunction:{|delay,action|timers.add([delay,action])},track:true));
    rack=instance.tool;
    check.value(rack.isKindOf(Tool),"real Tool base");
    check.value(instance.isKindOf(ToolInstance),"real ToolInstance");
    check.value(instance.trackingEnabled,"NodeManager tracking enabled");
    check.value(NodeManager.instance.registry[instance].notNil,"native Tool projection");
    check.value(rack.ready,"rack ready");
    rack.gui((processRunner:{|command|guiCommand=command;nil}));
    check.value(guiCommand.find("apps/awb-shell/shell/main.mjs").notNil,"native GUI uses the standard Shell entry");
    check.value(guiCommand.find(instance.instanceID).notNil and:{guiCommand.find("AWB_RACK_SC_LIBRARY_ROOT").notNil} and:{guiCommand.find("--tool-instance=").notNil} and:{guiCommand.find("--owner-pid=").notNil},"GUI carries exact native binding and durable library root");
    check.value(rack.slotIDs.size==5,"fixed plus spare capacity");
    check.value(rack.inputFor(\a).index!=rack.inputFor(\b).index,"independent persistent input buses");
    check.value(rack.postFor(\a).index!=rack.inputFor(\a).index,"independent recording tap");
    check.value(rack.snapshot[\channels].every{|c|c[\sends].values.every{|v|v==0}},"no default dry routing");
    check.value(rack.slotAt(\fx1)[\active].isNil,"unassigned FX silent");
    rack.setSend(\a,\mast,0.3);rack.setLevel(\a,0.8);
    snapshot=rack.snapshot;
    rack.applyMix((channels:[(id:\a,sends:(verb:0.2))]));
    check.value(rack.channelAt(\a)[\gains][0]==0.3,"sparse mix preserves omitted send");
    rack.applyMix((channels:[(id:\a,sends:(mast:0))]));
    check.value(rack.channelAt(\a)[\gains][0]==0,"explicit zero clears send");
    reject.value({rack.applyMix((channels:[(id:\a,sends:(verb:0.9,unknown:1))]))},"invalid mix rejected before mutation");
    check.value(rack.channelAt(\a)[\gains][1]==0.2,"invalid mix has no partial side effect");
    source={|amp=0.1|DC.ar(amp)*EnvGen.ar(Env.perc(0.01,0.1),doneAction:2)};
    full=rack.prepareVoice(\test_voice,source);
    small=rack.prepareVariant(\test_voice,[\mast,\verb]);
    check.value(full[\def].children.count{|u|u.isKindOf(OffsetOut)}==5,"full wrapper has five send writers");
    check.value(small[\def].children.count{|u|u.isKindOf(OffsetOut)}==2,"packed wrapper has two send writers");
    check.value(rack.prepareVariant(\test_voice,[\verb,\mast])===small,"variant cache canonicalises order");
    check.value(rack.voiceArguments(\test_voice,(mast:0.5),[\mast,\verb])[3]==[0.5,0],"missing voice gain defaults to zero");
    reject.value({rack.voiceArguments(\test_voice,(fx1:1),[\mast,\verb])},"packed wrapper rejects unavailable destination");
    reject.value({rack.voiceArguments(\test_voice,(mast: -1),[\mast,\verb])},"negative direct gain rejected");
    check.value(rack.voiceArguments(\test_voice,(mast:1),[\mast,\verb],(mast:rack.inputFor(\b)))[1][0]==rack.inputFor(\b).index,"intentional channel bus override");
    reject.value({rack.voiceArguments(\test_voice,(mast:1),[\mast,\verb],(mast:Bus(\audio,0,1,server)))},"hardware bus override rejected");
    check.value(rack.prepareVariant(\test_voice,[\mast])[\def].children.count{|u|u.isKindOf(OffsetOut)}==1,"single-port packed wrapper");
    check.value(rack.voiceArguments(\test_voice,Dictionary["mast"->0.5],[\mast])[3]==[0.5],"string profile keys normalised");
    reject.value({rack.preparedVariant(\test_voice,[\verb])},"unprepared notes never compile graphs");
    rack.voiceEvent(\test_voice,(mast:0.3),[],[\mast]).play;
    check.value(msgs.last[0]==9,"custom pattern event starts a routed voice");
    check.value(rack.voiceEvent(\test_voice,(mast:1),[],[\mast,\verb])[\type]==\awbSendVoice,"pattern-playable event");
    oldBus=rack.destinationFor(\fx1).index;
    gen=rack.setFX(\fx1,\pass,(limiter:false));
    rack.setFX(\fx1,\pass,(limiter:false));
    gen=rack.slotAt(\fx1)[\active];
    reject.value({rack.setFX(\fx1,{|ctx|Error("broken factory").throw})},"processor factory failure is rolled back");
    check.value(rack.slotAt(\fx1)[\active]===gen,"failed replacement preserves the active processor");
    check.value(rack.destinationFor(\fx1).index==oldBus,"FX replacement preserves destination bus");
    check.value(rack.slotAt(\fx1)[\retiring].notEmpty,"replaced FX retained for tails");
    rack.setFX(\fx1,\pass);rack.setFX(\fx1,\pass);
    check.value(rack.slotAt(\fx1)[\retiring].size==2,"retiring FX budget bounded");
    reject.value({rack.setFollower(\follow1,(blend:1.1))},"invalid follower blend rejected");
    reject.value({rack.setFollower(\follow1,(attack:inf))},"nonfinite follower time rejected");
    oldBus=rack.measurementFor(\env).index;
    check.value(rack.measurementFor(\env).rate==\control,"control send has separate KR measurement");
    check.value(oldBus!=rack.controlFor(\env).index,"measurement and envelope buses are distinct");
    rack.setDetector(\env);gen=rack.slotAt(\env)[\detector];
    reject.value({rack.setDetector(\env,(rise:inf))},"invalid detector time rejected");
    reject.value({rack.setDetector(\env,(mode:\rms))},"unimplemented detector mode rejected");
    check.value(rack.slotAt(\env)[\detector]===gen,"invalid detector edit leaves active node untouched");
    rack.setDetector(\env,(gainDb:6));check.value(rack.slotAt(\env)[\detector]===gen,"detector edit preserves stateful node");
    rack.setControlFollower(\env,\short,(attack:0.2,release:0.4));
    rack.setControlFollower(\env,\long,(attack:8,release:9,scale:2.5));
    check.value(rack.followerFor(\env,\short).index!=rack.followerFor(\env,\long).index,"one measurement feeds independent follower outputs");
    gen=rack.slotAt(\env)[\consumers][\short][\node];
    rack.setControlFollower(\env,\short,(scale:2));
    check.value(rack.slotAt(\env)[\consumers][\short][\node]===gen,"follower edits preserve envelope state");
    reject.value({rack.setControlFollower(\env,\short,(blend:inf))},"nonfinite consumer settings rejected");
    reject.value({rack.measurementFor(\mast)},"audio FX destination cannot masquerade as control send");
    oldBus=rack.followerFor(\env,\short).index;rack.clearControlFollower(\env,\short);
    rack.setControlFollower(\env,\short);
    check.value(rack.followerFor(\env,\short).index==oldBus,"consumer output survives clear and reassignment");
    rack.setReturn(\env,0.5);check.value(rack.slotAt(\env)[\level]==0.5,"shared control amount is independent from instrument send gain");
    reject.value({rack.applyMix((returns:(mast:0.2,env:2)))},"invalid control amount rejected before sparse mix mutation");
    rack.clearDetector(\env);check.value(rack.measurementFor(\env).index.notNil,"detector removal preserves shared KR address");
    one=AWBSendRackTool.open(AWBControlSendProfile.configure((width:1,channels:[\only],fixedFX:[\mast],dynamicFX:0,spareFollowers:0)),(server:server,sendFunction:{|msg|msgs.add(msg)},track:false));
    oneRack=one.tool;AWBControlSendProfile.install(oneRack);
    check.value(AWBControlSendProfile.baseLaunchBuses(oneRack).size==16,"sixteen exact ef source aliases exposed");
    check.value(AWBControlSendProfile.baseLaunchBuses(oneRack)[\ef_mast2]===oneRack.measurementFor('mod-stut'),"Mast 2 is independent Stutter source");
    oneRack.setControlSendEnabled(\c1,false);
    check.value(oneRack.slotAt(\c1)[\controlEnabled].not,"control send can pause owned detector and envelopes");
    oneRack.setControlSendEnabled(\c1,true);
    reject.value({oneRack.setControlSendEnabled(\c1,1)},"pause rejects ambiguous boolean value");
    check.value(oneRack.followerIDs.size==16,"BaseLaunch profile has a distinct fixed control-send bank");
    check.value(oneRack.slots.values.collect{|slot|slot[\consumers].size}.sum==25,"BaseLaunch independent envelope presets installed");
    check.value(oneRack.channelAt(\only)[\gains].every{|gain|gain==0},"profile does not infer routes from FX names");
    one.close;
    one=AWBSendRackTool.open((width:1,channels:[\only],fixedFX:[\mast],dynamicFX:0,fixedFollowers:[],spareFollowers:0),(server:server,sendFunction:{|msg|msgs.add(msg)},watchNodes:true,track:false));
    oneRack=one.tool;
    check.value(oneRack.ready and:{oneRack.slotIDs.size==1},"single-channel single-send topology");
    oneRack.setSend(\only,\mast,0.5);
    oneRack.prepareVoice(\once,source);voiceNode=oneRack.playVoice(\once,(mast:0.5));
    voiceNode.changed(\n_end);
    check.value(one.ownedObjects.includes(voiceNode).not,"ended one-shot removed from native ownership");
    oneRack.rootGroup.changed(\n_end);
    check.value(one.status==\closed,"externally ended root closes ToolInstance");
    one.close;
    oldBus=rack.controlFor(\follow1).index;
    rack.setFollower(\follow1,(curve:\log));rack.clearFollower(\follow1);
    check.value(rack.controlFor(\follow1).index==oldBus,"spare follower control bus remains stable");
    check.value(msgs.any{|m|m[0]==\c_set or:{m[0]=="/c_set"}} or:{msgs.any{|m|m[0]==16}},"inactive follower emits control reset");
    check.value(rack.promotionCandidate[\toolID]==\sendRack,"native Tool promotion candidate");
    check.value(instance.ownedObjects.includes(rack.rootGroup),"graph owned by native instance");
    check.value(NodeManager.instance.watchedEntries[rack.channelAt(\a)[\node]].owner===instance,"strip has native owner");
    instance.close;
    check.value(instance.status==\closed and:{rack.closed},"Tool close cleans rack");
    check.value(rack.slots.values.every{|slot|slot[\bus].index.isNil and:{slot[\measurementBus].isNil or:{slot[\measurementBus].index.isNil}} and:{slot[\consumers].values.every{|c|c[\bus].index.isNil}}},"owned audio buses freed");
    reject.value({rack.setSend(\a,\mast,1)},"closed rack rejects control changes");
} {|error|error.reportError;failures.add(error.errorString)};
["RACK_CONTRACT",checks,failures.size].postln;
if(failures.isEmpty){"AWB_RACK_CONTRACT_RESULT=PASS".postln;0.exit}{"AWB_RACK_CONTRACT_RESULT=FAIL".postln;1.exit};
)
