{
  "schema": "awb.tool/1",
  "id": "score-studio",
  "name": "Score Studio",
  "version": "0.1.0",
  "renderer": {
    "entry": "dist/index.html",
    "preloadProtocol": 1,
    "crossOriginIsolated": false
  },
  "view": {
    "defaultWidth": 1440,
    "defaultHeight": 900,
    "allowMultiple": true
  },
  "launchProfiles": [
    { "id": "hosted", "label": "Open hosted" }
  ],
  "capabilities": {
    "filesystem": ["open-file", "open-directory", "save-file"],
    "media": [],
    "connections": ["hosted-timeline"]
  },
  "connectionPolicies": {
    "hosted-timeline": {
      "allowedPrefixes": ["/awb/timeline/", "/awb/synthdef/", "/awb/audition/", "/awb/nm/"],
      "clientIdentityAddresses": ["/awb/timeline/hello", "/awb/synthdef/hello", "/awb/audition/hello"],
      "disconnectAddresses": ["/awb/timeline/disconnect", "/awb/synthdef/disconnect", "/awb/audition/disconnect"]
    }
  },
  "hostBindings": {
    "nodeManager": { "toolSource": "scoreArranger" }
  },
  "documentKinds": [
    { "id": "score", "label": "Score", "extensions": ["score.json"],
      "actions": ["new", "recent", "browse"], "profileID": "hosted" }
  ]
}
