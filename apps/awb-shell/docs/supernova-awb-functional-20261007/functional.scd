(
var root="AWB_FUNCTIONAL_ROOT".getenv,engine="AWB_FUNCTIONAL_ENGINE".getenv,port="AWB_FUNCTIONAL_PORT".getenv.asInteger;
var server,check,await,finish,failed=List.new,checks=0,bootCount=0,bootAction,events=Dictionary.new,responders=List.new,coreInstance,core;
var readValue,reading,value,token="AWB_FUNCTIONAL_TOKEN".getenv;
Archive.archiveDir=root;
check={|ok,label|checks=checks+1;if(ok){("PASS "++label).postln}{failed.add(label);("FAIL "++label).postln}};
await={|predicate,label,timeout=15|var start=Main.elapsedTime;while{predicate.value.not and:{(Main.elapsedTime-start)<timeout}}{0.01.wait};if(predicate.value.not){Error("Timed out: "++label).throw}};
finish={|code|Routine({responders.do(_.free);coreInstance.tryPerform(\close);if(server.serverRunning){server.sync;server.quit;await.value({server.serverRunning.not},"quit",10)};ServerBoot.remove(bootAction,server);("AWB_FUNCTIONAL_CHECKS="++checks++" FAILED="++failed.size).postln;("AWB_FUNCTIONAL_DONE="++code).postln;code.exit}).play(SystemClock)};
Server.program="exec "++engine.shellQuote;
server=Server(\awbFunctional,NetAddr("127.0.0.1",port),ServerOptions.new.device_("1248").sampleRate_(44100).hardwareBufferSize_(512).blockSize_(128).numInputBusChannels_(0).numOutputBusChannels_(4).numAudioBusChannels_(2048).numControlBusChannels_(16384).maxLogins_(2).memSize_(262144));
server.options.ugenPluginsPath=[root+/+"plugins"];server.options.threads=2;Server.default=server;
responders.add(OSCFunc({|msg|if(msg[1].asString=="/notify"){("RAW_NOTIFY "++msg.asCompileString).postln}},'/done',server.addr));
bootAction={bootCount=bootCount+1};ServerBoot.add(bootAction,server);
readValue={|bus|reading=false;value=nil;bus.get({|x|value=x;reading=true});await.value({reading},"bus read");value};
SystemClock.sched(600,{"FAIL controller watchdog".postln;finish.value(1);nil});
Routine({try{
 10.do{|i|server.boot;await.value({server.serverRunning},"boot "++i,25);server.sync;0.1.wait;
  check.value(bootCount==(i+1),"F1 boot finalisation "++i);check.value(server.statusWatcher.notified,"F1 notified "++i);check.value(server.maxNumClients==2,"F1 language maxLogins option "++i);
  if(i<9){server.quit;await.value({server.serverRunning.not},"quit cycle");0.15.wait};
 };
 check.value((server.sampleRate-44100).abs<1,"running sample rate");
 {var before,after;before=server.nextNodeID;server.sendMsg('/notify',1,server.clientID);0.2.wait;after=server.nextNodeID;check.value(after==(before+1),"F1 repeat notify preserves allocator")}.value;
 server.notify=false;0.2.wait;check.value(server.statusWatcher.notified.not,"F1 notify-off acknowledgement");server.notify=true;await.value({server.statusWatcher.notified},"notify on");server.sync;
 check.value(bootCount==10,"F1 notify toggle does not boot-finalise again");
 ['/n_go','/n_end','/n_on','/n_off','/n_move'].do{|address|events[address]=List.new;responders.add(OSCFunc({|msg|events[address].add(msg.copy)},address,server.addr))};
 SynthDef(\awbFunctionalVoice,{|out=0,gate=1|var env=EnvGen.kr(Env.asr(0.001,1,0.01),gate,doneAction:2);Out.ar(out,DC.ar(0.01)*env)}).add;
 SynthDef(\awbFunctionalShot,{|out=0|var env=EnvGen.kr(Env.perc(0.001,0.015),doneAction:2);Out.ar(out,DC.ar(0.01)*env)}).add;
 SynthDef(\awbFunctionalControl,{|out=0,value=0.4|Out.kr(out,value)}).send(server);
 SynthDef(\awbFunctionalConsumer,{|out=0,value=0|ReplaceOut.kr(out,value)}).send(server);
 SynthDef(\awbFunctionalDetector,{|out=0|Out.kr(out,A2K.kr(EnvDetect3.ar(DC.ar(0.25),0.00562,0.0234)))}).send(server);server.sync;
 coreInstance=AWBCoreTool.open((),(server:server,track:true));core=coreInstance.tool;await.value({core.ready},"Core readiness");server.sync;
 {var baseline,voice,bus,ids=List.new,shotCount,pattern;
 bus=core.createBus(\voiceBus,\audio,1);baseline=NodeManager.instance.registry.values.count{|e|e.type!=\container};shotCount=coreInstance.ownedObjects.size;
 20.do{|batch|50.do{|n|var voice=core.addSynth(("shot"++batch++"_"++n).asSymbol,\awbFunctionalShot,[\out,bus.index]);ids.add(voice.nodeID)};server.sync;0.2.wait};
 await.value({coreInstance.ownedObjects.size==shotCount},"1000 voice ownership cleanup",2);
 check.value(NodeManager.instance.registry.values.count{|e|e.type!=\container}==baseline,"F2 1000 voices registry baseline");
 check.value(events['/n_go'].count{|m|ids.includes(m[1])}==1000,"F2 1000 n_go notifications");
 check.value(events['/n_end'].count{|m|ids.includes(m[1])}==1000,"F2 1000 n_end notifications");
 voice=core.addSynth(\persistent,\awbFunctionalVoice,[\out,bus.index]);voice.register;server.sync;0.1.wait;check.value(voice.isPlaying,"F2 NodeWatcher persistent live");
 voice.run(false);server.sync;0.05.wait;check.value(voice.isRunning.not and:{events['/n_off'].any{|m|m[1]==voice.nodeID}},"F2 pause n_off");
 voice.run(true);server.sync;0.05.wait;check.value(voice.isRunning and:{events['/n_on'].any{|m|m[1]==voice.nodeID}},"F2 resume n_on");
 voice.moveToHead(core.groupAt(\voices));server.sync;0.05.wait;check.value(events['/n_move'].any{|m|m[1]==voice.nodeID},"F2 move notification");
 voice.set(\gate,0);server.sync;await.value({coreInstance.ownedObjects.size==shotCount},"release cleanup",2);check.value(NodeManager.instance.registry.values.count{|e|e.type!=\container}==baseline,"F2 release baseline");
 core.playTracked((instrument:\awbFunctionalVoice,out:bus.index,dur:0.03));0.15.wait;server.sync;await.value({coreInstance.ownedObjects.size==shotCount},"Event cleanup",2);check.value(NodeManager.instance.registry.values.count{|e|e.type!=\container}==baseline,"F2 tracked Event cleanup");
 pattern=core.playTracked(Pbind(\instrument,\awbFunctionalVoice,\out,bus.index,\dur,Pseq(Array.fill(10,0.03),1)));
 0.8.wait;server.sync;await.value({coreInstance.ownedObjects.size==shotCount},"Pattern cleanup",2);check.value(NodeManager.instance.registry.values.count{|e|e.type!=\container}==baseline,"F2 tracked Pattern cleanup");
 }.value;
 {var p,mod,producer,source,connection,done=false,consumer,targetBus,got=false,live;
 mod=core.createBus(\mod);targetBus=core.createBus(\consumer);producer=core.addSynth(\modProducer,\awbFunctionalControl,[\out,mod.index,\value,0.4],\detectors);
 source=core.registerModulationSource(\modSource,mod,producer);p=core.createParam(\probe,0.2,\unipolar,0.5);
 connection=p.addModulation(\source,source,amount:0.5,action:{|c,error|check.value(error.isNil,"F4 registered writer ordering");done=true});await.value({done},"connection validation");
 server.sync;0.05.wait;check.value((readValue.value(p.outputBus)-0.3).abs<0.0001,"F4 additive modulation output");
 consumer=core.addSynth(\consumer,\awbFunctionalConsumer,[\out,targetBus.index],\fx);p.mapTo(consumer,\value);server.sync;0.05.wait;
 consumer.getLive(\value,{|x|live=x;got=true});await.value({got},"getLive");check.value((live[\value]-0.3).abs<0.0001 and:{live[\mapped]==p.outputBus.index},"F4 getLive mapped output");
 p.set(0.8,0.15,-4);0.05.wait;p.set(0.1,0.08,0);0.15.wait;server.sync;check.value((readValue.value(p.outputBus)-0.2).abs<0.0001,"F4 interrupted base transition endpoint");
 p.removeModulation(\source);server.sync;0.05.wait;check.value((readValue.value(p.outputBus)-0.1).abs<0.0001,"F4 writer removal clears modulation");
 p.unmapFrom(consumer,\value);consumer.set(\value,0.7);server.sync;0.03.wait;check.value((readValue.value(targetBus)-0.7).abs<0.0001,"F4 unmap restores plain value");
 }.value;
 {var b=core.createBus(\detector),node;node=core.addSynth(\detector,\awbFunctionalDetector,[\out,b.index],\detectors);server.sync;0.2.wait;check.value((readValue.value(b)-0.25).abs<0.001,"F4 actual EnvDetect3 audio-to-control output")}.value;
 coreInstance.close;server.sync;0.1.wait;check.value(core.closed and:{coreInstance.ownedObjects.isEmpty},"F2 complete Core cleanup");check.value(NodeManager.instance.registry.values.count{|e|e.type!=\container}==0 and:{NodeManager.instance.registry.keys.any{|o|o.isKindOf(Node)}.not},"F2 only virtual containers remain");
 NodeManagerOSCBridge.start;SynthDefContextOSCBridge.start;
 AWBHostControl.start(\always,\ide,token);
 thisProcess.interpreter.executeFile("/Users/willy/awb/apps/awb-shell/sc/AWBScBusAudio.scd");
 {var b=Bus.audio(server,2),c=Bus.control(server,2),g=Group.tail(server.defaultGroup),s;
 SynthDef(\awbFunctionalScopes,{|out=0,control=0|Out.ar(out,SinOsc.ar([211,337])*0.02);Out.kr(control,SinOsc.kr([0.7,1.1])*0.5)}).send(server);server.sync;
 s=Synth(\awbFunctionalScopes,[\out,b.index,\control,c.index],g);server.sync;
 File.use(root+/+"session.json","w",{|f|f.write("{\"langPort\":"++NetAddr.langPort++",\"enginePort\":"++port++",\"enginePID\":"++server.pid++",\"audioBus\":"++b.index++",\"controlBus\":"++c.index++"}")});
 OSCdef(\functionalFinish,{|msg|if(msg[1].asString==token){g.free;b.free;c.free;finish.value(if(failed.isEmpty){0}{1})}},'/awb/functional/finish');
 OSCdef(\functionalAction,{|msg,time,addr|
 if(msg[1].asString==token){switch(msg[2].asSymbol,\disable,{AWBHostControl.disableNodeManager},\enable,{AWBHostControl.enableNodeManager},\restartBridge,{NodeManagerOSCBridge.stop;NodeManagerOSCBridge.start},\entry,{NodeManager.register((probe:msg[3]),\container,(name:"functional marker "++msg[3]))});addr.sendMsg('/awb/functional/done',msg[2])}
 },'/awb/functional/action');
 "AWB_FUNCTIONAL_READY_FOR_SHELL".postln;
 }.value;
}{|error|error.reportError;finish.value(1)}}).play(SystemClock);
)
