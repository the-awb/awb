(
var server,instance,chain,messages=List.new,checks=0,failures=List.new,check,reject,configuration,borrowed,internal,command,preset,gate,third,cleaned=0;
check={|ok,label|checks=checks+1;if(ok){("PASS "++label).postln}{failures.add(label);("FAIL "++label).postln}};
reject={|fn,label|var caught=false;try{fn.value}{caught=true};check.value(caught,label)};
try{
 server=Server(\chainTest,NetAddr("127.0.0.1",59999),ServerOptions.new.numOutputBusChannels_(4).numInputBusChannels_(0));
 SynthDef(\chainGain,{|in=0,out=0,gain=1|Out.ar(out,In.ar(in,2)*gain)}).add;
 AWBChain.registerFactory(\test,{|c|internal=c.bus;c.addSynth(\first,\chainGain,[\in,c.input.index,\out,internal.index]);c.addSynth(\last,\chainGain,[\in,internal.index,\out,c.output.index]);c.bind(\gain,\first,\gain);c.bindSetter(\trim,{|v|messages.add([\trim,v])},(kind:\adapter));});
 configuration=(name:"Test Chain",factory:\test,controls:[(id:\gain,min:0,max:2,default:1),(id:\trim,min:0,max:1,default:0.5)]);
 borrowed=Bus.audio(server,2);
 instance=AWBChain.open(configuration,(server:server,input:borrowed,sendFunction:{|m|messages.add(m)},track:true));chain=instance.tool;
 check.value(chain.isKindOf(Tool) and:{instance.isKindOf(ToolInstance)},"native Tool and instance");
 check.value(instance.trackingEnabled and:{NodeManager.instance.registry[instance].notNil},"NodeManager projection");
 check.value(instance.ownedObjects.includes(chain.group) and:{chain.nodes.size==2},"group and two fixed nodes owned");
 check.value(NodeManager.instance.watchedEntries[chain.nodes[\first]].owner===instance,"fixed node records owner");
 chain.ownResource(\fixture,{cleaned=cleaned+1});
 check.value(chain.ready and:{chain.get(\trim)==0.5},"ready after defaults applied");
 check.value(messages.any{|m|m==[\trim,0.5]},"adapter default setter runs");
 chain.set(\gain,0.25);check.value(chain.get(\gain)==0.25,"language edits update state");
 checks=checks;gate=messages.size;chain.set(\gain,0.25);check.value(messages.size==gate,"unchanged edit skips setter");
 reject.value({chain.applyValues((gain:0.9,trim:2))},"invalid batch rejected");check.value(chain.get(\gain)==0.25,"invalid batch is prevalidated");
 reject.value({chain.set(\gain,inf)},"nonfinite value rejected");reject.value({chain.set(\unknown,1)},"unknown control rejected");
 reject.value({chain.bind(\gain,\last,\gain)},"duplicate binding rejected");
 preset=chain.promotionCandidate;chain.set(\gain,1.5);chain.applyPresetConfig(preset[\config],preset[\selectedState]);check.value(chain.get(\gain)==0.25,"preset restores values on the same graph");
 reject.value({chain.applyPresetConfig((factory:\other),(values:()))},"preset cannot silently replace graph");
 chain.gui((processRunner:{|cmd|command=cmd;nil}));check.value(command.find("apps/awb-shell/shell/main.mjs").notNil and:{command.find("AWB_CHAIN_INSTANCE_ID").notNil} and:{command.find(instance.instanceID).notNil},"GUI uses native Shell and exact instance binding");
 instance.close;check.value(chain.closed and:{instance.status==\closed},"close closes native instance");
 check.value(cleaned==1,"registered resource cleanup runs once");instance.close;check.value(cleaned==1,"second close does not repeat cleanup");
 check.value(internal.index.isNil and:{chain.output.index.isNil},"owned buses freed");check.value(borrowed.index.notNil,"borrowed port survives close");check.value(instance.ownedObjects.isEmpty,"ownership emptied");
 reject.value({chain.bus},"closed chain cannot allocate");reject.value({chain.set(\gain,0)},"closed chain cannot edit");
 reject.value({AWBChain.open(configuration,(server:server,input:Bus(\audio,0,2,server),sendFunction:{},track:false))},"hardware bus borrowing rejected");
 reject.value({AWBChain.open(configuration,(server:server,input:Bus.audio(server,1),sendFunction:{},track:false))},"width mismatch rejected");
 reject.value({AWBChain.open((factory:\missing),(server:server,sendFunction:{},track:false))},"unknown factory rejected");
 AWBChain.registerFactory(\broken,{|c|internal=c.bus;c.addSynth(\one,\chainGain,[\in,c.input.index,\out,c.output.index]);});
 reject.value({AWBChain.open((factory:\broken,controls:[(id:\unbound)]),(server:server,sendFunction:{},track:false))},"factory missing binding rejected");check.value(internal.index.isNil,"factory failure cleans internal bus");
 AWBChain.registerFactory(\gate,{|c|c.holdReady;c.bindSetter(\gain,{|v|gate=v});});gate=nil;
 instance=AWBChain.open((factory:\gate,controls:[(id:\gain,default:0.4)]),(server:server,sendFunction:{},track:false));chain=instance.tool;
 check.value(chain.ready.not and:{gate.isNil},"async factory dependency delays defaults");chain.releaseReady;check.value(chain.ready and:{gate==0.4},"ready after dependency completion");instance.close;
 instance=AWBChain.open(configuration,(server:server,sendFunction:{},track:true,watchNodes:true));chain=instance.tool;
 chain.controlBinding(\gain)[\setter].value(0.125);check.value(chain.get(\gain)==0.125,"adapter binding setter keeps Chain state authoritative");
 chain.group.changed(\n_end);check.value(instance.status==\closed and:{chain.closed},"externally freed group closes instance");
 AWBChainFuzz.register(server,false);instance=AWBChain.open(AWBChainFuzz.config,(server:server,sendFunction:{},track:false));chain=instance.tool;
 check.value(chain.nodes.size==3 and:{chain.controls.size==5},"native Fuzz builds three fixed stages and five controls");chain.set(\drive,12);chain.set(\bias, -0.25);check.value(chain.get(\drive)==12,"native Fuzz named controls editable");instance.close;
 AWBChain.registerFactory(\fractional,{|c|c.bindSetter(\value,{})});instance=AWBChain.open((factory:\fractional,controls:[(id:\value,min:0,max:0.3,default:0)]),(server:server,sendFunction:{},track:false));chain=instance.tool;
 chain.set(\value,0.30000001192092896);check.value(chain.get(\value)==0.3,"OSC float endpoint rounding clamps to semantic range");reject.value({chain.set(\value,0.301)},"endpoint tolerance does not admit real overshoot");instance.close;
 AWBChain.registerFactory(\badDefault,{|c|internal=c.bus;c.bindSetter(\gain,{Error("bad default setter").throw})});
 reject.value({AWBChain.open((factory:\badDefault,controls:[(id:\gain)]),(server:server,sendFunction:{},track:false))},"default setter failure rejects open");check.value(internal.index.isNil,"default setter failure frees owned resources");
 borrowed.free;
 ("AWB_CHAIN_CONTRACT_CHECKS="++checks).postln;if(failures.isEmpty){"AWB_CHAIN_CONTRACT_RESULT=PASS".postln;0.exit}{1.exit};
}{|error|error.reportError;1.exit};
)
