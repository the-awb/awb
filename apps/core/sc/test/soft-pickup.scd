(
var server,core,p,m,other,checks=0,failed=List.new,check,messages=List.new,phases=List.new,held,count;
check={|ok,label|checks=checks+1;if(ok){("PASS "++label).postln}{failed.add(label);("FAIL "++label).postln}};
Routine({try{
    server=Server(\softPickupTest,NetAddr("127.0.0.1",59996));
    core=AWBCoreTool.open((),(server:server,track:false,sendFunction:{|msg|messages.add(msg)})).tool;
    p=core.createParam(\gain,0.5);m=p.createMidiSource(nil,0,1,0,127,true,false);
    p.addDependant({|o,what,value|if(what==\pickupBase){phases.add(value)}});
    check.value(m.pickupWait==1 and:{m.pickupFade==0.5},"default hold is one second; fade is half a second");
    m.acceptBase(20,0.5);m.acceptBase(80,0.5);
    check.value(m.pickupPhase==\warning and:{m.latched.not} and:{p.baseTarget==0.5},"crossing warns and holds the observed value");
    m.receiveCC(100);0.8.wait;check.value(p.baseTarget==0.5 and:{m.latched.not},"controller motion is held during warning");
    0.35.wait;check.value(m.pickupPhase==\ramping and:{p.baseTarget>0.5} and:{p.baseTarget<(100/127)},"fade starts only after the hold");
    m.receiveCC(110);0.5.wait;check.value(m.latched and:{m.pickupPhase==\idle} and:{(p.baseTarget-(110/127)).abs<1e-6},"fade ends at moving controller's latest position");
    check.value(phases.asArray==[\warning,\ramping,\idle],"GUI phase notifications are sparse");
    m.receiveCC(90);check.value((p.baseTarget-(90/127)).abs<1e-6,"live control follows after fade");
    m.softPickup(0.12,0.5);p.setBase(0.5);m.acceptBase(64,0.5);m.receiveCC(100);m.receiveCC(20);
    check.value(m.pickupPhase==\warning and:{p.baseTarget==0.5},"reversing during hold does not cancel or change the held value");
    0.16.wait;
    check.value(m.latched and:{m.pickupPhase==\ramping} and:{p.baseTarget<0.5} and:{p.baseTarget>(20/127)},"fade captures controller position after the hold, not at threshold");
    m.receiveCC(20);held=p.baseTarget;m.receiveCC(30);
    check.value((p.baseTarget-held-(10/127)).abs<0.002,"controller movement passes through at full sensitivity during fade");
    m.receiveCC(127);check.value(p.baseTarget==1,"negative offset cannot push above MIDI ceiling");
    0.55.wait;check.value(m.pickupPhase==\idle and:{m.latched} and:{p.baseTarget==1},"reversed pickup completes without locking out control");
    m.softPickup(0.12,0.18);p.setBase(0.5);m.acceptBase(20,0.5);m.acceptBase(80,0.5);m.receiveCC(100);
    0.15.wait;m.receiveCC(0);check.value(p.baseTarget==0 and:{m.latched},"positive offset cannot push below MIDI floor");
    0.2.wait;check.value(p.baseTarget==0 and:{m.pickupPhase==\idle},"moving back during fade remains live and completes");
    m.acceptBase(20,0.5);m.acceptBase(80,0.5);p.setBase(0.2);0.35.wait;
    check.value(p.baseTarget==0.2 and:{m.latched.not},"GUI or automation edits cancel pending pickup");
    m.acceptBase(20,0.2);m.acceptBase(80,0.2);0.17.wait;p.setBase(0.3);0.25.wait;
    check.value(p.baseTarget==0.3 and:{m.latched.not},"external edits cancel an active fade");
    // Freeze the actual observed value, rather than the target of a running envelope.
    p.setBase(0.9,2);m.acceptBase(53,0.42);check.value((p.baseTarget-0.42).abs<1e-6,"pickup freezes observed base, not an automation target");
    p.removeSource(m);held=p.baseTarget;0.35.wait;check.value(p.baseTarget==held and:{p.midiPickupPhase==\idle},"removal cancels tasks and clears warning");
    m=AWMidiCCIn(nil,nil,0,2,0,127,true,\amount).softPickup(0.03,0.06);p.addSource(m);p.setPolarity(\bipolar);p.setAmount(-0.5);
    m.acceptBase(0,-0.5);m.acceptBase(100,-0.5);check.value(p.midiPickupPhase(\amount)==\warning and:{p.midiPickupPhase(\base)==\idle},"amount pickup has independent GUI phase");
    m.receiveCC(127);0.15.wait;check.value(p.amountTarget==1 and:{m.latched},"bipolar modulation amount uses the same soft pickup");m.free;
    p=core.createParam(\frequency,200,ControlSpec(20,20000,\exp));m=p.createMidiSource(nil,0,3,0,127,true,false).softPickup(0.02,0.06);
    m.acceptBase(0,200);m.acceptBase(90,200);0.12.wait;
    check.value((p.baseTarget-p.midiSpec.map(90/127)).abs<1e-5,"exponential native spec retains MIDI normalization");m.free;
    p=core.createParam(\level,0.5,ControlSpec(0,6.dbamp));p.midiRange(0,1);m=p.createMidiSource(nil,0,4,0,127,true,false).softPickup(0.02,0.06);
    m.acceptBase(0,0.5);m.acceptBase(127,0.5);0.12.wait;check.value(p.baseTarget==1,"soft fade retains MIDI unity ceiling");
    p.setBase(6.dbamp);check.value(m.acceptBase(127,6.dbamp).not and:{m.pickupPhase==\idle},"values above MIDI ceiling cannot be picked up");
    p.setBase(0.5);m.acceptBase(0,0.5);m.acceptBase(127,0.5);other=p.createMidiSource(nil,0,5,0,127,true,false);
    other.resync;check.value(p.midiPickupPhase==\warning,"idle source cannot hide another source's warning");
    other.free;m.free;
    p=core.createParam(\choice,1,ControlSpec(0,3));m=AWMidiCCIn(nil,nil,0,6,0,3,true,\choice);p.addSource(m);
    m.acceptBase(1,1);check.value(m.latched and:{m.pickupPhase==\idle} and:{p.baseTarget==1},"discrete selectors remain immediate and stepped");
    m.free;p=core.createParam(\reconfigure,0.5);m=p.createMidiSource(nil,0,7,0,127,true,false).softPickup(0.02,0.08);
    m.acceptBase(0,0.5);m.acceptBase(127,0.5);p.setPolarity(\bipolar);0.15.wait;
    check.value(m.pickupPhase==\idle and:{m.latched.not} and:{p.baseTarget==0.5},"polarity changes cancel deferred pickup safely");
    p=core.createParam(\thresholdOnly,0.5);m=p.createMidiSource(nil,0,10,0,127,true,false).softPickup(0,0);
    m.acceptBase(10,0.5);check.value(m.latched.not and:{p.baseTarget==0.5},"threshold-only pickup holds until the controller reaches the value");
    m.acceptBase(80,0.5);check.value(m.latched and:{m.pickupPhase==\idle} and:{(p.baseTarget-(80/127)).abs<1e-6},"threshold crossing gives immediate control without warning or smoothing");
    m.receiveCC(100);check.value((p.baseTarget-(100/127)).abs<1e-6,"threshold-only pickup follows subsequent controller movement");m.free;
    p=core.createParam(\bypassBase,0.5);m=p.createMidiSource(nil,0,8,0,127,false,false);m.receiveCC(10);
    check.value(m.latched and:{m.pickupPhase==\idle} and:{(p.baseTarget-(10/127)).abs<1e-6},"bypassed baseline responds immediately without readback or smoothing");
    other=AWMidiCCIn(nil,nil,0,9,0,127,false,\amount);p.addSource(other);other.receiveCC(100);
    check.value(other.latched and:{other.pickupPhase==\idle} and:{(p.amountTarget-(100/127)).abs<1e-6},"bypassed amount responds immediately without readback or smoothing");
    core.close;count=messages.size;0.2.wait;check.value(m.closed and:{messages.size==count},"closing owner cancels every deferred MIDI write");
    ("AWB_SOFT_PICKUP_CHECKS="++checks).postln;if(failed.isEmpty){"AWB_SOFT_PICKUP_RESULT=PASS".postln;0.exit}{1.exit};
}{|error|error.reportError;core.tryPerform(\close);1.exit}}).play(SystemClock);
)
