(
var server,core,instance,p,q,native,restored,preset,address,wire,bus,route,writer,view,messages=List.new,checks=0,failures=List.new,check,reject,events=List.new;
check={|ok,label|checks=checks+1;if(ok){("PASS "++label).postln}{failures.add(label);("FAIL "++label).postln}};
reject={|fn,label|var caught=false;try{fn.value}{caught=true};check.value(caught,label)};
try{
 server=Server(\paramGUIContract,NetAddr("127.0.0.1",59996));
 instance=AWBCoreTool.open((params:[(id:\gain,base:0.2)]),(server:server,sendFunction:{|m|messages.add(m)},track:false));core=instance.tool;p=core.param(\gain);q=core.createParam(\second,0.5);
 check.value(p.asBus.numChannels==1 and:{p.observationBus.numChannels==2},"mono output preserved; observations use separate allocation");
 check.value(p.observationIndices==[p.observationBus.index,p.observationBus.index+1,p.outputBus.index],"explicit three-value observation order");
 SynthDef(\paramGUIWriter,{|out=0,rate=2|Out.kr(out,SinOsc.kr(rate)*0.1)}).add;
 p.createModulationWriter(\custom,\paramGUIWriter,[\rate,3]);
 p.declareModulationWriterControls(\custom,[(id:\rate,min:0.1,max:20)]);p.setModulationWriterControl(\custom,\rate,4);
 check.value(p.routeMetadata.detect{|r|r[\id]==\custom}[\controls][0][\value]==4,"declared writer controls retain edits");
 reject.value({p.setModulationWriterControl(\custom,\out,2)},"writer output cannot be edited");
 reject.value({p.declareModulationWriterControls(\custom,[(id:\missing,min:0,max:1)])},"undeclared writer controls rejected");
 p.removeModulationWriter(\custom);
 bus=core.createBus(\source);route=p.addModulation(\plain,bus,0.3,-2);
 p.setModulationAmount(\plain,-0.7);p.setModulationCurve(\plain,4);
 check.value(p.routeMetadata[0][\amount]==(-0.7) and:{p.routeMetadata[0][\curve]==4} and:{p.routeMetadata[0][\producer].isNil},"plain route edits retain truthful metadata");
 reject.value({p.setModulationAmount(\plain,9)},"source amount bounds enforced");
 reject.value({p.setModulationCurve(\plain,17)},"source curve bounds enforced");
 p.removeModulation(\plain);reject.value({p.setModulationAmount(\plain,1)},"removed source edits rejected");
 p.modulationConnections[\pending]=(status:\pending);reject.value({p.setModulationAmount(\pending,1)},"pending edits explicitly rejected");p.modulationConnections.removeAt(\pending);
 instance.addDependant({|o,what,payload|if(what==\toolEvent){events.add(payload)}});
 p.setBase(0.4);check.value(instance.config[\params].detect{|entry|entry[\id]==\gain}[\base]==0.4,"canonical snapshot retains changed entry");
 check.value(events.last[\kind]==\paramChanged and:{events.last[\payload][\entry][\id]==\gain} and:{events.last[\payload][\state].isNil},"gesture publishes parameter delta without full snapshot");
 check.value(p.polarity==\unipolar and:{p.nativeSpec.not},"bare controls default to unipolar normalized multiplier");
 p.setPolarity(\bipolar);check.value(p.spec.minval==(-1) and:{p.spec.maxval==1} and:{p.baseTarget==0.4},"bare bipolar polarity preserves current amount and widens domain");
 reject.value({p.setAmount(-1.01)},"bipolar overall amount rejects below minus one");reject.value({p.setAmount(1.01)},"overall amount rejects above one");
 p.setAmount(-0.6);p.setPolarity(\unipolar);check.value(p.amountTarget==0,"unipolar switch clamps negative overall amount");reject.value({p.setAmount(-0.1)},"unipolar overall amount rejects negatives");p.setPolarity(\bipolar);p.setAmount(-0.4);
 p.setNormalized(-0.5);check.value(p.baseTarget==(-0.5) and:{p.normalizedValue(-0.5)==(-0.5)},"bipolar normalized setters accept negative multipliers");
 check.value(instance.config[\params].detect{|entry|entry[\id]==\gain}[\polarity]==\bipolar,"polarity is retained in canonical entry delta");
 preset=core.promotionCandidate[\config];p.setPolarity(\unipolar);
 check.value(p.baseTarget==0 and:{p.spec.minval==0},"unipolar switch clamps negative bare control to zero");
 reject.value({p.setNormalized(-0.1)},"unipolar normalized setter rejects negative multiplier");
 core.applyPresetConfig(preset);check.value(p.polarity==\bipolar and:{p.baseTarget==(-0.5)},"preset validates amount against incoming polarity before applying");
 restored=AWBCoreTool.open(preset,(server:server,sendFunction:{|m|messages.add(m)},track:false));
 check.value(restored.tool.param(\gain).nativeSpec.not and:{restored.tool.param(\gain).polarity==\bipolar} and:{restored.tool.param(\gain).baseTarget==(-0.5)},"configuration reconstructs bare bipolar control");restored.close;
 native=core.createParam(\frequency,200,ControlSpec(20,20000,\exp));messages.clear;native.setPolarity(\bipolar);
 check.value(native.spec.minval==20 and:{native.spec.maxval==20000} and:{native.baseTarget==200} and:{messages.last.includes(\amountLo)} and:{messages.last.includes(\baseTarget).not},"explicit native spec and DSP ramp remain unchanged by display polarity");
 native.setAmount(-0.3);messages.clear;native.setPolarity(\unipolar);check.value(native.amountTarget==0 and:{native.baseTarget==200} and:{messages.last.includes(\baseTarget).not},"native spec polarity clamps amount without restarting base ramp");native.setPolarity(\bipolar);
 native.setNormalized(0);check.value((native.baseTarget-(20*1000.sqrt)).abs<0.000001 and:{native.normalizedValue(native.baseTarget).abs<0.000001},"bipolar zero maps through exponential ControlSpec midpoint");
 reject.value({native.setPolarity(\invalid)},"unknown polarity rejected");
 preset=core.promotionCandidate[\config];preset[\params].last[\polarity]=\invalid;
 reject.value({core.applyPresetConfig(preset)},"preset validates all polarities before mutation");
 core.removeParam(\frequency);
 view=AWParamInspector.openMany([p,q],(launch:false),instance);
 address=AWParamTestAddress();view.tool.sendParam(address,"probe",p.name);wire=address.messages.last;
 check.value(wire.size==20 and:{wire[17]=="bipolar"} and:{wire[18]==0} and:{wire.copyRange(14,16)==p.observationIndices},"language metadata serializes polarity and sparse observation indices");
 check.value(view.tool.owner===instance,"inspector panel retains owning Tool identity");
 check.value(view.tool.params.size==2 and:{p.isKindOf(Tool).not},"one inspector borrows multiple plain AWParams");
 p.watch(6);messages.clear;
 view.close;check.value(messages.isEmpty,"inspector closure does not alter a language watch client");check.value(p.closed.not and:{q.closed.not},"inspector closure preserves borrowed parameters");
 view=AWParamInspector.open(p,(launch:false));p.free;
 check.value(view.status==\closed,"parameter closure invalidates inspector binding");
 instance.close;
 ("AWB_PARAM_GUI_CONTRACT_RESULT="++if(failures.isEmpty){"PASS"}{"FAIL"}++" checks="++checks).postln;
 if(failures.notEmpty){1.exit}{0.exit};
}{|error|error.reportError;instance.tryPerform(\close);1.exit};
)
