(
var server,instance,core,param,checks=0,failed=List.new,messages=List.new,check,reject,borrowed,owned,cleaned=0,clone,preset,child,def,prior,midi,route,rack,precision;
check={|ok,label|checks=checks+1;if(ok){("PASS "++label).postln}{failed.add(label);("FAIL "++label).postln}};
reject={|fn,label|var caught=false;try{fn.value}{caught=true};check.value(caught,label)};
try{
 server=Server(\coreContract,NetAddr("127.0.0.1",59997),ServerOptions.new.numOutputBusChannels_(4).numInputBusChannels_(0));
 instance=AWBCoreTool.open((params:[(id:\gain,base:0.2,amount:0.5,min:0,max:1,polarity:\bipolar)]),(server:server,sendFunction:{|msg|messages.add(msg)},track:true));core=instance.tool;param=core.param(\gain);
 check.value(core.isKindOf(Tool) and:{core.ready},"core opens through native ToolInstance");
 check.value(instance.definition.id==\awbCore and:{NodeManager.instance.watchedEntries[core.group].owner===instance},"root has Tool/NodeManager owner");
 precision=core.createParam(\precision,nil,ControlSpec(0,0.3));precision.setBase(0.30000001192092896);
 check.value(precision.baseTarget==0.3,"float32 endpoint accepted without allowing real overshoot");
 reject.value({precision.setBase(0.301)},"real range overshoot rejected");core.removeParam(\precision);
 precision=core.createParam(\frequency,nil,ControlSpec(20,20000,\exp));
 check.value(precision.baseTarget==20,"omitted base uses spec default");core.removeParam(\frequency);
 check.value(core.groups.size==7,"ordered phase groups created");
 check.value(param.isKindOf(AWParam) and:{param.inputBus.index!=param.outputBus.index},"AWParam has two distinct owned control buses");
 check.value(param.sourceGroup.group===param.group and:{param.synth.group===param.group},"modulation sources and processor share owned group");
 check.value(NodeManager.instance.watchedEntries[param.synth].owner===instance,"parameter processor has core ownership");
 check.value(param.baseSmoothing==0.5,"continuous bases default to half-second lag");
 param.setBase(0.6);check.value(messages.last[messages.last.indexOf(\baseLag)+1]==0.5 and:{messages.last[messages.last.indexOf(\baseDur)+1]==0},"omitted base duration uses smoothing");
 param.setI(0.4);check.value(messages.last[messages.last.indexOf(\baseLag)+1]==0.5 and:{messages.last[messages.last.indexOf(\baseDur)+1]==0},"legacy base alias retains smoothing");
 param.setM(64);check.value(messages.last[messages.last.indexOf(\baseLag)+1]==0.5 and:{messages.last[messages.last.indexOf(\baseDur)+1]==0},"MIDI base setter retains smoothing");
 param.setNormalized(0.5);check.value(messages.last[messages.last.indexOf(\baseLag)+1]==0.5 and:{messages.last[messages.last.indexOf(\baseDur)+1]==0},"normalized base setter retains smoothing");
 param.setBase(0.6,0);check.value(messages.last[messages.last.indexOf(\baseDur)+1]==0 and:{messages.last[messages.last.indexOf(\baseLag)+1]==0.5},"zero-duration target changes still pass through base lag");
 param.setBase(0.6,2);check.value(messages.last[messages.last.indexOf(\baseDur)+1]==2 and:{messages.last[messages.last.indexOf(\baseLag)+1]==0.5},"explicit scene ramps also pass through base lag");
 param.baseSmoothing=0.2;param.setBase(0.6);check.value(messages.last[messages.last.indexOf(\baseLag)+1]==0.2 and:{param.configuration[\baseSmoothing]==0.2},"per-parameter smoothing is configurable and serialized");
 reject.value({param.baseSmoothing=(-1)},"negative default smoothing is rejected");
 param.setAmount(0.3);check.value(messages.last[messages.last.indexOf(\amountDur)+1]==0,"amount default remains immediate");
 param.baseSmoothing=0.5;
 param.set(0.7,2,-4).setAmount(-0.5,1,4);check.value(param.baseTarget==0.7 and:{param.amountTarget== -0.5},"base and amount targets are independent");
 check.value(messages.last.includes(\amountSerial) and:{messages.last.includes(\amountDur)},"transition command contains duration and retrigger serial");
 param.setBase(0.7,3);check.value(messages.last.includes(\baseSerial),"identical target can restart transition");
 param.setBase(0.123456);check.value(param.baseTarget==0.123456,"base keeps full precision without MIDI rounding");
 check.value(param.cachedBase.isNil,"unobserved cache is explicitly unknown");
 param.receiveState(['/awb/param/state',param.synth.nodeID,-1,0.3,0.4,0.5,0,0]);
 check.value(param.cachedBase==0.3 and:{param.cachedEffective==0.5} and:{param.snapshot[\observedAt].notNil},"readback distinguishes observed base from target/effective");
 param.receiveState(['/awb/param/state',param.synth.nodeID,-1,inf,0.4,0.5,0,0]);check.value(param.cachedBase==0.3,"invalid readback ignored");
 reject.value({param.getBase({})},"score/capture transport cannot pretend to give live readback");
 param.watch(8);check.value(messages.last.includes(\replyRate),"observation is opt in");param.stopWatching;
 reject.value({param.setBase(-0.1)},"out of range base rejected");reject.value({param.setAmount(inf)},"infinite amount rejected");
 reject.value({param.setBase(0.5,-1)},"negative duration rejected");reject.value({param.setAmount(0,1,100)},"invalid curve rejected");
 reject.value({param.setModCurve(\exp)},"unsupported shape rejected explicitly");
 reject.value({core.createParam(\gain)},"duplicate parameter rejected");
 reject.value({core.createParam(\invalid,0,ControlSpec(0,1,\sin))},"unsupported parameter warp rejected");
 def=SynthDef(\coreDestination,{|gain=0.1|Out.ar(0,DC.ar(gain))});SynthDescLib.global.add(def.asSynthDesc);prior=Synth.basicNew(\coreDestination,server);
 param.mapTo(prior,\gain);check.value(messages.last.includes(param.outputBus.index),"maps effective bus to destination");
 reject.value({param.mapTo(prior,\missing)},"missing synth control rejected");
 clone=core.createParam(\other,0.6);clone.mapTo(prior,\gain);owned=messages.size;param.unmapFrom(prior,\gain);check.value(messages.size==owned,"old owner cannot unmap a newer mapping");clone.unmapFrom(prior,\gain);
 midi=param.createMidiSource(nil,0,1,0,127,true,false).softPickup(0,0);
 check.value(param.sources.includes(midi) and:{midi.param===param},"MIDI is an attached parameter source");
 param.addSource(midi);check.value(param.sources.size==1,"attaching a source twice is idempotent");
 param.setBase(0.5);midi.acceptBase(20,0.5);check.value(midi.latched.not,"MIDI pickup ignores distant controller");
 midi.acceptBase(80,0.5);check.value(midi.latched and:{(param.baseTarget-(80/127)).abs<1e-6},"MIDI crossing takes over base without effective value");
 param.setBase(0.6,2);check.value(midi.latched.not,"external base transition rearms MIDI pickup");
 midi.acceptBase(76,0.6);check.value(midi.latched,"MIDI pickup accepts proximity to current base");
 clone.addSource(midi);check.value(midi.param===clone and:{param.sources.isEmpty} and:{clone.sources.includes(midi)},"source can move between parameters");
 clone.removeSource(midi);check.value(midi.closed and:{midi.param.isNil} and:{clone.sources.isEmpty},"removing source disposes and detaches it");
 reject.value({param.addSource(midi)},"closed source cannot be reattached");
 midi=param.createMidiSource(nil,0,2,20,100,false,false);midi.receiveCC(127);
 check.value((param.baseTarget-(100/127)).abs<1e-6,"MIDI source applies configured range without pickup read");
 param.removeSource(midi,false);prior=param.baseTarget;midi.receiveCC(0);
 check.value(midi.closed.not and:{midi.param.isNil} and:{param.baseTarget==prior},"detached source cannot change its previous parameter");
 param.addSource(midi);midi.receiveCC(0);check.value((param.baseTarget-(20/127)).abs<1e-6,"detached source can be attached again");midi.free;
 check.value(param.sources.isEmpty,"freeing source removes attachment");
 reject.value({param.createMidiSource(nil,16,2)},"invalid MIDI channel rejected before attachment");
 reject.value({param.createMidiSource(nil,0,128)},"invalid MIDI CC rejected before attachment");
 reject.value({param.createMidiSource(nil,0,2,-1,127)},"invalid MIDI range rejected before attachment");
 midi=param.createMidiSource(AWBCoreTestMidiSource(12345),0,3);
 check.value(midi.sourceUID==12345,"legacy MIDISource-shaped object resolves to source UID");
 prior=param.baseTarget;MIDIIn.doControlAction(999,0,3,127);MIDIIn.doControlAction(12345,1,3,127);MIDIIn.doControlAction(12345,0,4,127);
 check.value(param.baseTarget==prior,"installed MIDI source filters UID channel and CC");
 MIDIIn.doControlAction(12345,0,3,127);check.value(param.baseTarget==1,"installed MIDI callback writes parameter base");
 midi.midiDef;prior=messages.size;MIDIIn.doControlAction(12345,0,3,0);
 check.value(messages.size==(prior+1),"repeated midiDef does not duplicate callback");
 param.removeSource(midi);prior=param.baseTarget;MIDIIn.doControlAction(12345,0,3,127);
 check.value(param.baseTarget==prior,"source removal unregisters installed MIDI callback");
 midi=param.createMidiSource(12345,0,3);
 borrowed=Bus.control(server,1);route=param.addModulation(\source,borrowed,0.3,-4);
 check.value(route.group===param.sourceGroup,"modulation connection is ordered before processor");
 reject.value({param.addModulation(\source,borrowed)},"duplicate modulation connection rejected");
 param.removeModulation(\source);check.value(borrowed.index.notNil,"removing modulation preserves borrowed source bus");borrowed.free;
 borrowed=Bus.audio(server,2);core.borrowBus(\borrowed,borrowed);owned=core.createBus(\owned,\audio,2);
 reject.value({core.createBus(\owned)},"duplicate bus rejected");reject.value({core.createBus(\bad,\audio,0)},"invalid bus width rejected");
 core.ownResource(\custom,\resource,{cleaned=cleaned+1});check.value(core.resourceAt(\custom)==\resource,"named custom ownership");
 AWBChain.registerFactory(\emptyCore,{|chain|});child=core.openChain(\fx,(factory:\emptyCore));
 check.value(child.tool.group.group===core.groupAt(\fx),"child Chain is contained in chosen phase");
 check.value(instance.ownedObjects.includes(child),"child retains its own ToolInstance plus root lifecycle ownership");
 reject.value({core.openChain(\fx,(factory:\emptyCore))},"duplicate child key rejected");
 rack=core.openRack(\rack,(channels:[(id:\in0)],fixedFX:[\mast],dynamicFX:0,fixedFollowers:[],spareFollowers:0));
 check.value(rack.tool.rootGroup.group===core.groupAt(\routing),"rack root adopted into Core routing phase");
 core.closeTool(\rack);check.value(rack.status==\closed,"child rack can close independently");
 reject.value({core.playTracked((instrument:\coreDestination))},"no implicit hardware output in tracked notes");
 param.baseSmoothing=0.25; preset=core.promotionCandidate;check.value(preset[\config][\params].size==2 and:{preset[\metadata][\scope]==\coreParametersAndGroups},"preset scope is explicit and reconstructible");
 clone=AWBCoreTool.open(preset[\config].deepCopy,(server:server,sendFunction:{},track:false));clone.tool.param(\gain).baseSmoothing=0;clone.tool.applyPresetConfig(preset[\config],());check.value(clone.tool.param(\gain).baseSmoothing==0.25,"preset application restores per-parameter lag");
 check.value(clone.tool.param(\gain).baseTarget==param.baseTarget,"preset reconstructs base target");clone.close;
 instance.close;
 check.value(midi.closed and:{midi.param.isNil},"parameter closure disposes attached MIDI sources");
 check.value(core.closed and:{param.closed} and:{child.status==\closed},"core close disposes parameters and child Tools");
 check.value(owned.index.isNil and:{borrowed.index.notNil},"owned bus recycled; borrowed bus retained");
 check.value(cleaned==1 and:{instance.ownedObjects.isEmpty},"custom resources released once and registry emptied");
 instance.close;check.value(cleaned==1,"close is idempotent");borrowed.free;
 reject.value({param.set(0.1)},"closed parameter rejects edits");
 check.value(AWParam.synthDef.children.count{|u|u.isKindOf(LocalIn)}==1,"transition state uses internal feedback, no extra buses");
 ("AWB_CORE_CONTRACT_CHECKS="++checks).postln;if(failed.isEmpty){"AWB_CORE_CONTRACT_RESULT=PASS".postln;0.exit}{1.exit};
}{|error|error.reportError;1.exit};
)
