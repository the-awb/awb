{
  "name": "awb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @awb/lissajous-engine",
    "test": "npm test --workspaces --if-present",
    "test:browser": "npm run test:browser --workspace @awb/lissajous-engine",
    "verify": "npm run build && npm test"
  },
  "devDependencies": {
    "@react-three/fiber": "^8.15.16",
    "@vitejs/plugin-react": "^6.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.185.1",
    "vite": "^8.2.2"
  }
}
